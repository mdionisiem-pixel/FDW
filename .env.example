# Copy to .env and edit. Never commit .env.

# 1 = sample responses, no model calls, no spend. 0 = real model calls.
FDW_DRY_RUN=1

# Needed only when FDW_DRY_RUN=0.
ANTHROPIC_API_KEY=

# Ceiling on output tokens for one model call. The model's reasoning counts toward it,
# so a low value cuts answers off. Only tokens actually produced are billed.
FDW_MAX_OUTPUT_TOKENS=64000

# Hard stop for model spend per cycle, in US dollars.
FDW_CYCLE_LIMIT_USD=5

# Stage 1 web research: maximum searches per run, and price per search in US dollars.
FDW_RESEARCH_MAX_SEARCHES=12
FDW_SEARCH_PRICE_USD=0.01

# Models. A model must also have a price in FDW_PRICES in fdw/settings.py.
FDW_MODEL_WRITER=claude-sonnet-5-5
FDW_MODEL_EXTRACTOR=claude-haiku-5-5

# Django. Keep DEBUG=1 on your own machine only.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Dublin

# Image generation through OpenRouter. Needed only when FDW_DRY_RUN=0.
OPENROUTER_API_KEY=
# Image models to compare in the bake-off, comma separated.
FDW_BAKEOFF_MODELS=openai/gpt-image-2,black-forest-labs/flux.2-pro,google/gemini-3.1-flash-image,google/gemini-3-pro-image
FDW_IMAGE_RESOLUTION=2K
# Hard stop for the whole bake-off, in US dollars.
FDW_BAKEOFF_LIMIT_USD=10

# Stage 3 sourcing check.
# Pieces whose gross margin is below this share of the price are flagged (0.5 = 50%).
FDW_MIN_GROSS_MARGIN=0.5
# Euros per unit of other currencies, to compare supplier prices with euro retail prices.
# Example: FDW_EUR_RATES=USD=0.86,GBP=1.17. Without a rate, the margin is left blank.
FDW_EUR_RATES=

# How much the model reasons before answering a review step: low, medium or high.
# Reviews follow a fixed checklist; design steps keep the model's default.
FDW_REVIEW_EFFORT=medium
# How many independent model calls may run at once (the three collections in stage 2).
# 1 runs them one after another.
FDW_PARALLEL_CALLS=3

# Stage 4 visual prototypes. Uses OPENROUTER_API_KEY above.
FDW_IMAGE_MODEL=google/gemini-3-pro-image
# Hard stop for stage 4 in one cycle, in US dollars (images plus their reviews).
FDW_VISUALS_LIMIT_USD=15
# Attempts per shot before it comes to you marked "could not meet standard".
FDW_MAX_SHOT_ATTEMPTS=3
# Images made at the same time.
FDW_VISUAL_WORKERS=3
